# Copy to .env.local (npm run dev) or .env (docker compose). Every variable is optional:
# with none set, Pakka runs fully on the rule-based extractor and says "key not set".

# LLM extraction (either one). Anthropic wins if both are set.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Force a provider: anthropic | gemini | rules (rules = never call an LLM)
PAKKA_LLM_PROVIDER=

# Telephony adapters (documented stubs, not wired; see docs/TELEPHONY.md)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
EXOTEL_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
